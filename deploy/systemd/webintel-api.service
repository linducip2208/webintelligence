[Unit]
Description=WebIntel FastAPI
After=network.target mysql.service redis.service
[Service]
User=www-data
WorkingDirectory=/www/wwwroot/web-intelligence/source/python
EnvironmentFile=/www/wwwroot/web-intelligence/.env
ExecStart=/www/wwwroot/web-intelligence/source/python/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
[Install]
WantedBy=multi-user.target
