# ============ APP ============
ENV=production
APP_NAME=webintel
SECRET_KEY=CHANGE_ME_32_CHARS_MIN
API_BASE=http://127.0.0.1:8000
API_TOKEN=
REQUIRE_AUTH=0
DATA_DIR=data
# ============ DATABASE (MySQL 8.4) ============
DATABASE_URL=mysql+pymysql://webintel:CHANGE_ME@127.0.0.1:3306/webintel
DB_NAME=webintel
# ============ REDIS ============
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ADDR=127.0.0.1:6379
# ============ AI (abstraction; configure any OpenAI-compatible) ============
MUSE_SPARK_BASE_URL=
MUSE_SPARK_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3
AI_TIMEOUT=60
# ============ COLLECTION ============
QUEUE=webintel:queue:jobs
COLLECTOR_UA=Mozilla/5.0 WebIntel-Collector/1.0
ROBOTS_ENFORCE=0
TRUSTED_EGRESS_CIDRS=
OWN_PROXY_URLS=
# ============ BROWSER ============
BROWSER_POOL=2
# ============ BRIGHT DATA ============
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
BRIGHTDATA_ENDPOINT=https://api.brightdata.com
# ============ SECURITY ============
CREDENTIALS_KEY=CHANGE_ME_FERNET_KEY
RATE_LIMIT_PER_MIN=20
# ============ STORAGE ============
MAX_BODY_BYTES=10485760
# ============ WEBHOOK ============
ALERT_WEBHOOK_URL=
# ============ EMAIL ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
# ============ OBSERVABILITY ============
LOG_LEVEL=info
# ============ WORKER ============
TICK_SCHEDULES=1
