# ============ APP ============
ENV=production
APP_NAME=webintel
SECRET_KEY=CHANGE_ME_32_CHARS_MIN
API_BASE=http://127.0.0.1:8000
API_TOKEN=
REQUIRE_AUTH=0
DATA_DIR=data
# ============ DATABASE (MySQL 8.4) ============
DATABASE_URL=mysql+pymysql://webintel:CHANGE_ME@127.0.0.1:3306/webintel
DB_NAME=webintel
# ============ REDIS ============
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ADDR=127.0.0.1:6379
# ============ AI (abstraction; configure any OpenAI-compatible) ============
MUSE_SPARK_BASE_URL=
MUSE_SPARK_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3
# chat = POST {BASE}/chat/completions | responses = POST {BASE}/responses
# (OpenCode Zen Go gateway https://opencode.ai/zen/go/v1 -> protocol responses)
MUSE_SPARK_PROTOCOL=chat
# Generic slot: ANY OpenAI-compatible endpoint, zero code changes.
# Example: CUSTOM_AI_NAME=my-gateway CUSTOM_AI_PROTOCOL=responses
CUSTOM_AI_NAME=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_PROTOCOL=chat
# Extra model ids allowed on top of plan allowlists (comma-separated, no code edit)
AI_EXTRA_MODELS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
XAI_API_KEY=
XAI_MODEL=grok-3-mini
COHERE_API_KEY=
COHERE_MODEL=command-r
TOGETHER_API_KEY=
TOGETHER_MODEL=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=muse-spark-1.3-contributor
OPENCODE_ZEN_API_KEY=
OPENCODE_API_KEY=
OPENCODE_ZEN_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1
AI_FALLBACKS=muse-spark,openai,anthropic,google,ollama
AI_TIMEOUT=60
# ============ COLLECTION ============
QUEUE=webintel:queue:jobs
COLLECTOR_UA=Mozilla/5.0 WebIntel-Collector/1.0
ROBOTS_ENFORCE=0
TRUSTED_EGRESS_CIDRS=
OWN_PROXY_URLS=
# ============ BROWSER ============
BROWSER_POOL=2
# ============ BRIGHT DATA ============
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
BRIGHTDATA_ENDPOINT=https://api.brightdata.com
# ============ SECURITY ============
CREDENTIALS_KEY=CHANGE_ME_FERNET_KEY
# HSTS header (TLS-terminated production behind Nginx only)
HSTS=0
# per-minute quotas per cost class (IP/user/key/org buckets; Redis-backed when available)
RATE_LIMIT_STANDARD=300
RATE_LIMIT_SEARCH=200
RATE_LIMIT_ANALYTICS=100
RATE_LIMIT_RESEARCH=30
RATE_LIMIT_AI=30
RATE_LIMIT_BROWSER=30
RATE_LIMIT_EXPORT=20
RATE_LIMIT_WEBHOOK=100
# ============ STORAGE ============
MAX_BODY_BYTES=10485760
# ============ WEBHOOK ============
ALERT_WEBHOOK_URL=
# ============ EMAIL ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
# ============ OBSERVABILITY ============
LOG_LEVEL=info
# ============ WORKER ============
TICK_SCHEDULES=1
